load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push", "oci_tarball")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

js_library(
    name = "lib",
    srcs = glob(
        ["**/*.js", "**/*.mjs", "**/*.json"],
        exclude = ["node_modules/**", "tests/**"],
    ),
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "app_layer",
    srcs = [":lib"],
    package_dir = "/app",
)

oci_image(
    name = "image",
    base = "@node_base",
    tars = [":app_layer"],
    entrypoint = ["node", "/app/server.js"],
    env = {
        "NODE_ENV": "production",
    },
    exposed_ports = ["8000/tcp"],
)

oci_tarball(
    name = "image_tarball",
    image = ":image",
    repo_tags = ["agent-platform/sillytavern:latest"],
)

oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/agent-platform/sillytavern",
)
