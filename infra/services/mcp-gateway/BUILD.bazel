load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push", "oci_tarball")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

js_library(
    name = "lib",
    srcs = glob(["src/**/*.ts"]),
    deps = [
        "//services/shared:lib",
        "@npm//express",
        "@npm//ws",
        "@npm//http-proxy-middleware",
    ],
)

esbuild(
    name = "bundle",
    entry_point = "src/server.ts",
    deps = [":lib"],
    platform = "node",
    target = "node22",
    output = "server.js",
)

js_binary(
    name = "mcp-gateway",
    entry_point = "server.js",
    data = [":bundle"],
)

pkg_tar(
    name = "bundle_layer",
    srcs = [":bundle"],
    package_dir = "/app",
)

oci_image(
    name = "image",
    base = "@node_base",
    tars = [":bundle_layer"],
    entrypoint = ["node", "/app/server.js"],
    env = {
        "NODE_ENV": "production",
    },
)

oci_tarball(
    name = "image_tarball",
    image = ":image",
    repo_tags = ["agent-platform/mcp-gateway:latest"],
)

oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/agent-platform/mcp-gateway",
)
