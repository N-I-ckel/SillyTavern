load("@rules_helm//helm:defs.bzl", "helm_install")

# Local K8s deployment (Kubeadm)
helm_install(
    name = "deploy_local",
    chart = "//charts/agent-platform:chart",
    release_name = "ap",
    namespace = "agent-platform",
    values = "//charts/agent-platform:values-local.yaml",
)

# Cloud deployment (GKE/RunPod)
helm_install(
    name = "deploy_cloud",
    chart = "//charts/agent-platform:chart",
    release_name = "ap",
    namespace = "agent-platform",
    values = "//charts/agent-platform:values-cloud.yaml",
)
