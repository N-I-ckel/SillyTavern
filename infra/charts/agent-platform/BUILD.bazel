load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test")

helm_chart(
    name = "chart",
    srcs = glob(["**/*.yaml", "**/*.tpl", "**/*.txt", "**/*.json"]),
    chart = "Chart.yaml",
    values = "values.yaml",
    images = {
        "sillytavern": "//services/sillytavern:image",
        "mcp-gateway": "//services/mcp-gateway:image",
        "agent-orchestrator": "//services/agent-orchestrator:image",
        "comfyui": "//services/comfyui:image",
    },
    visibility = ["//visibility:public"],
)

helm_lint_test(
    name = "lint_test",
    chart = ":chart",
)

exports_files([
    "values.yaml",
    "values-local.yaml",
    "values-cloud.yaml",
])
