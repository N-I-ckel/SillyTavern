{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sillytavern"],
  "properties": {
    "sillytavern": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicaCount": { "type": "integer", "minimum": 1 }
      }
    },
    "mcpGateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "comfyui": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "gpu": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        "easywan22": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "modelStorage": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "gpuOperator": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "version": { "type": "string" }
      }
    },
    "doppler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "project": { "type": "string" },
        "config": { "type": "string" },
        "tokenSecretName": { "type": "string" }
      }
    },
    "nim": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "openclaw": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
